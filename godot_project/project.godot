; Engine configuration file.
; Kaptein Sabeltann og Grusomme Gabriels forbannelse - HD Remake (Godot 4)

config_version=5

[application]

config/name="Kaptein Sabeltann og Grusomme Gabriels forbannelse HD"
config/description="Moderne HD-remake i Godot 4 med oppskalerte PBR-teksturer, dynamisk belysning og moderne 3D-motor."
config/version="0.3-ultra-hd"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

LevelCatalog="*res://scripts/autoload/LevelCatalog.gd"
GameState="*res://scripts/autoload/GameState.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

