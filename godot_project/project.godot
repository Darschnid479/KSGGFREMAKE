[rendering]

rendering_device/driver.windows="vulkan"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=2
environment/ssil/quality=2
environment/glow/upscale_mode=1
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48

[importer_defaults]

texture={
"compress/high_quality": false,
"compress/mode": 2,
"mipmaps/generate": true,
"mipmaps/limit": -1,
"process/size_limit": 0
}
